///$tab VERSION
// En esta pestaña se registran los cambios realizados en el informe para realizar el control de backups

// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- //
//	Fecha		Redmine		Incidencia																				Solución
// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- //

// 20221108		-			Actualización Fecha Emisión Facturas											Se añade la tabla DIV_INDEMNIZACIONES para leer el campo de fecha de emisión de la facturación
// 20221116		-			Actualización Estados Incumplimientos Gesred									Se añade la tabla GR_ESTADOS_INCUMPLI para obtener los estados de incumplimiento [EI_CD_ESTADO]/[EI_DS_ESTADO]
// 20221116		-			Añadimos las reclamaciones pendientes de Diversa								Se añade de la tabla DIV_Proc_Gen_Pena_Det los casos pendientes 
// 20221128		-			Se quitan del Loop temporal de carga las tablas sin temporalidad en la carga 	DIV_Proc_Gen_Pena_Det, DIV_Penalizaciones, DIV_Recl_Ser, DIV_Ctt_Recl, DIV_OrdenSer, DIV_OrdenReclSer, DIV_Tipo_Relacion_Cli, GR_INCUMPLIMIENTOS, GR_ACOMETIDA_SC, GR_PRES, GR_SERV_TIPO_USO, GR_TIPO_ESPE, GR_OT, GR_AVIS, GR_AVIS_OT, GR_OT_HIST_ESTADO, GR_OT_PROPIEDADES, GR_ESTADOS_OT, GR_ESPE_OT, DIV_Facturas		
// 20230215		-			Se desestiman de pendientes aquellas sin contrato								Se pone en la tabla DIV_PROC_GEN_PENA_PENDIENTES_S0 la condición whent cd_ctt is not null
