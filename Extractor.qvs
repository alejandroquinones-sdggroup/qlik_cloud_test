///$tab END LOOP

		LET vMinDate=date(addmonths(vMinDate , 1));
		
		LET vMinYearMonthLoop =  Year(vMinDate)&Num(Month(vMinDate),'00');



LOOP;
///$tab DIV_ESPERAS_RELACIONES
// Prefijo DIV -> Origen: DIVERSA

DIV_ESPERAS_RELACIONES_S0:
LOAD
	cod_ind,
	cns_recl_ser,
	fech_ini_ind,
	fech_fin_ind,
    fech_ini_est_recl,
	fech_fin_est_recl
;
SQL
SELECT 
	e.cod_inst, 
	p.cod_ind, 
	e.cns_recl_ser,
	p.fech_ini_ind,
	p.fech_fin_ind,
	fech_ini_est_recl,
	fech_fin_est_recl
FROM [AQ_Italia_Auditoria].[dbo].[DIV_PROC_GEN_PENA_DET] p, [AQ_Italia_Auditoria].[dbo].[DIV_Estado_Recl] e
WHERE p.cod_inst = 23901
   AND p.cod_ind IN (32,34,35)
   AND p.cns_recl_ser IS NOT NULL
   AND p.cns_orden_ser IS NULL
   AND p.flg_genera_pena >= 0
   AND e.cod_inst = p.cod_inst
   AND e.cns_recl_ser = p.cns_recl_ser
   AND e.est_recl = 9
;

CALL StoreQVD_S0('DIV_ESPERAS_RELACIONES_S0')
DROP TABLE DIV_ESPERAS_RELACIONES_S0;
///$tab DIV_ESPERAS_ORDENES
// Prefijo DIV -> Origen: DIVERSA

DIV_ESPERAS_ORDENES_S0:
LOAD
	cod_ind,
	cns_orden_ser,
	fech_ini_ind,
	fech_fin_ind,
    fech_ini_est_orden,
	fech_fin_est_orden
;
SQL
SELECT 
	e.cod_inst, 
	p.cod_ind, 
	e.cns_orden_ser,
	p.fech_ini_ind,
	p.fech_fin_ind,
	fech_ini_est_orden,
	fech_fin_est_orden
FROM [AQ_Italia_Auditoria].[dbo].[DIV_PROC_GEN_PENA_DET] p, [AQ_Italia_Auditoria].[dbo].[DIV_Estado_Orden] e
WHERE p.cod_inst      = 23901
   AND p.cod_ind       = 12
   AND p.cns_orden_ser IS NOT NULL
   AND p.flg_genera_pena >= 0
   AND e.cod_inst      = p.cod_inst
   AND e.cns_orden_ser = p.cns_orden_ser
   AND e.est_orden     = 3
;

CALL StoreQVD_S0('DIV_ESPERAS_ORDENES_S0')
DROP TABLE DIV_ESPERAS_ORDENES_S0;
