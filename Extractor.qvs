///$tab INCIDENCIAS
// Prefijo DIV -> Origen: DIVERSA

///// LECTURA DE LAS INCIDENCIAS Y PRESTACIONES DESCARTADAS DE DIVERSA
//// TABLA [DIV_Proc_Gen_Pena_Det]
//// CUANDO EL FLAG flg_genera_pena=-1

DIV_INCIDENCIAS_DESCARTES_S0:
LOAD
	*
;

SELECT [Id]
      ,[cod_inst]
      ,[Fecha_Info]
      ,[cns_pena_det]
      ,[cod_proc]
      ,[cod_ind]
      ,[cod_ctt]
      ,[cns_recl_ser]
      ,[cns_orden_ser]
      ,[fech_generacion]
      ,[fech_ini_ind]
      ,[fech_fin_ind]
      ,[imp_pena]
      ,[tiempo_ind]
      ,[tiempo_pena]
      ,[flg_genera_pena]
      ,[texto_inci]
      ,[Create_Date]
      ,[Update_Date]
      ,[Create_User]
      ,[Update_User]
FROM [AQ_Italia_Auditoria].[dbo].[DIV_Proc_Gen_Pena_Det]
where flg_genera_pena<0
;

CALL StoreQVD_S0('DIV_INCIDENCIAS_DESCARTES_S0')
DROP TABLE DIV_INCIDENCIAS_DESCARTES_S0;
///$tab GR - MASTER
// Prefijo GR -> Origen: GESRED

GR_TIPOS_INCUMPLIMIENTOS_S0:
SQL
SELECT
*
FROM [AQ_Italia_Auditoria].[dbo].GR_TIPOS_INCUMPLIMIENTOS
WHERE CC_DT_FECHA_BAJA IS NULL; // 144652

CALL StoreQVD_S0('GR_TIPOS_INCUMPLIMIENTOS_S0')
DROP TABLE GR_TIPOS_INCUMPLIMIENTOS_S0;
