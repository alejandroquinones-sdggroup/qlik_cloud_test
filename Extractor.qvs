///$tab STAR LOOP
DO WHILE vMinYearMonthLoop <= $(vMaxYearMonth)
		
		//LET QvConditionMin=date(addmonths(vAQDateFrom , j));
		LET QvConditionMin=date(vMinDate);
		
		LET QvDateMinForSelectTEXT=text(date(QvConditionMin,'YYYYMMDD'));
	 	
	 	LET QvYearMonthQVD = text(date(QvConditionMin,'YYYYMM'));
	 	
	 	TRACE --> Loop for QvYearMonthQVD: $(QvYearMonthQVD);
///$tab CPI
// Prefijo ODS -> Origen: Carga Ficheros Manuales

CPI_S0_$(QvYearMonthQVD):
LOAD 
	  YEAR([DATE_ORA_INIZIO_CHIAMATA])*100+MONTH([DATE_ORA_INIZIO_CHIAMATA])		AS fech_mes
	  ,[ID]
      ,[DATE_ORA_INIZIO_CHIAMATA]
      ,[DATE_ORA_ABBANDONO]
      ,[DATE_RISPOSTA_OPT]
      ,[NUMERO_CHIAMANTE]
      ,[ID_CHIAMATA]
      ,[SERVIZIO]
      ,[GESTITA_OPERATORE]
      ,[ESITO_GESTIONE]
      ,[CPI]
;
SELECT
	*
FROM [AQ_Italia_Auditoria].[dbo].[ODS_CALTAQUA_CPI]
WHERE YEAR([DATE_ORA_INIZIO_CHIAMATA])*100+MONTH([DATE_ORA_INIZIO_CHIAMATA])=$(QvYearMonthQVD);

CALL StoreQVD_S0('CPI_S0_$(QvYearMonthQVD)')
DROP TABLE CPI_S0_$(QvYearMonthQVD);



CPI_2_S0_$(QvYearMonthQVD):
LOAD
 	  [PERIODO_ANALISIS]				AS fech_mes
 	  ,[ID]
      ,[NUMERO_PROGRESSIVO]
      ,[AREA_INTERVENTO]
      ,[CODICE_RINTRACCIABILITA]
      ,[ID_PRESTAZIONE]
      ,[COGNOME_LEAD]
      ,[NOME_LEAD]
      ,[NUM_CHIAMANTE]
      ,[TIPOLOGIA]
      ,[PUNTO_CONSIGNA]
      ,[TIPI_INTERVENTO]
      ,[DATTAGLIO]
      ,[DESCRIZIONE]
      ,[INIZIO_CHIAMATA]
      ,[ORA_INIZIO_CHIAMATA]
      ,[RISPOSTA_OPERATORE]
      ,[ORA_RISPOSTA_OPERATORE]
      ,[DATA_ARRIVO_SUL_POSTO]
      ,[ORA_ARRIVO_SUL_POSTO]
      ,[MANCATO_RISPETTO_STANDARD]
      ,[DIFERENZA]
      ,[TICKET_ID]
      ,[RIFERIMANTO_REGISTRAZIONE]
      ,[NOMBRE_FICHERO]
      ,[PERIODO_ANALISIS]
;

SQL 
SELECT
	*
FROM [AQ_Italia_Auditoria].[dbo].[ODS_CALTAQUA_PI_TABELLA]
WHERE [PERIODO_ANALISIS]=$(QvYearMonthQVD)
;

CALL StoreQVD_S0('CPI_2_S0_$(QvYearMonthQVD)')
DROP TABLE CPI_2_S0_$(QvYearMonthQVD);
///$tab CC
// Prefijo ODS -> Origen: Carga Ficheros Manuales

CC_S0_$(QvYearMonthQVD):
LOAD 
	  YEAR([DATE_ORA_INIZIO_CHIAMATA])*100+MONTH([DATE_ORA_INIZIO_CHIAMATA])		AS fech_mes
	  ,[ID]
      ,[DATE_ORA_INIZIO_CHIAMATA]
      ,[DATE_ORA_ABBANDONO]
      ,[DATE_RISPOSTA_OPT]
      ,[NUMERO_CHIAMANTE]
      ,[ID_CHIAMATA]
      ,[SERVIZIO]
      ,[GESTITA_OPERATORE]
      ,[ESITO_GESTIONE]
      ,[ATTESA]

;
SELECT
	*
FROM [AQ_Italia_Auditoria].[dbo].[ODS_CALTAQUA_CC]
WHERE YEAR([DATE_ORA_INIZIO_CHIAMATA])*100+MONTH([DATE_ORA_INIZIO_CHIAMATA])=$(QvYearMonthQVD);

CALL StoreQVD_S0('CC_S0_$(QvYearMonthQVD)')
DROP TABLE CC_S0_$(QvYearMonthQVD);
///$tab STORICO_CODA
// Prefijo ODS -> Origen: Carga Ficheros Manuales

STORICO_CODA_S0_$(QvYearMonthQVD):
LOAD
	  0																			AS ORIGEN_CODA
	  ,[ID]
      ,[DATE_INFO]
      ,Date(Date([DATE_INFO]) + time([ORA_RICHIESTA],'hh:mm'), 'DD/MM/YYYY hh:mm:ss') as DATE_INFO_INIZIO
      ,Date(Date([DATE_INFO]) + time([ORA_CHIAMATA], 'hh:mm'), 'DD/MM/YYYY hh:mm:ss') as DATE_INFO_FINE
      ,IF(ORA_RICHIESTA<'08:30:00.0000000','08:30:00.0000000',ORA_RICHIESTA)	AS [ORA_RICHIESTA]
      ,[ORA_RICHIESTA]															AS [ORA_RICHIESTA_ORIGINAL]
      ,[ORA_CHIAMATA]
      ,[ORA_PRENOTAZIONE]
      ,[ORA_EVASIONE]
      ,[TIPO_PRENOTAZIONE]
      ,[TIPO_CHIAMATA]
      ,[TIPO_EVASIONE]
      ,[SERVICIO]
      ,[NUMERO]
      ,[BIGLIETTO]
      ,[CODICE_FISCALE]
      ,[LINGUA]
      ,[TIPOLOGIA]
;

SELECT 
	*
FROM [AQ_Italia_Auditoria].[dbo].[ODS_STORICO_CODA_CALTANISSETTA]
WHERE YEAR([DATE_INFO])*100+MONTH([DATE_INFO])=$(QvYearMonthQVD)
AND TIPO_EVASIONE = 'Normale'
;


CONCATENATE(STORICO_CODA_S0_$(QvYearMonthQVD))
LOAD
	  1						AS ORIGEN_CODA
	  ,[ID]
	  ,DATE_INFO
      ,Date(Date([DATE_INFO]) + time(PRENOTAZIONE, 'hh:mm'), 'DD/MM/YYYY hh:mm:ss') as DATE_INFO_INIZIO
      ,Date(Date([DATE_INFO]) + time(CHIAMATA, 'hh:mm'), 'DD/MM/YYYY hh:mm:ss') as DATE_INFO_FINE
      ,[PRENOTAZIONE]		AS [ORA_RICHIESTA]
      ,[CHIAMATA]			AS [ORA_CHIAMATA]
      ,[INIZIO]				AS [ORA_PRENOTAZIONE]
      ,[FINE]				AS [ORA_EVASIONE]
      ,[APPUNTAMENTO]
      ,[TIPO_PRENOTAZIONE]
      ,[TIPO_CHIAMATA]
      ,[TIPO_EVASIONE]
      ,[SERVICIO]
      ,[SERVICIO_EFFETTIVO]
      ,[NUMERO]
      ,[BIGLIETTO]
      ,[CODICE_FISCALE]
      ,[LINGUA]
      ,[TIPOLOGIA]
      ,[COMUNE]
      ,[CONTATTO]
;

SELECT 
	*
FROM [AQ_Italia_Auditoria].[dbo].[ODS_STORICO_CODA_GELA]
WHERE YEAR([DATE_INFO])*100+MONTH([DATE_INFO])=$(QvYearMonthQVD)
AND TIPO_EVASIONE = 'Normale'
;

CALL StoreQVD_S0('STORICO_CODA_S0_$(QvYearMonthQVD)')
DROP TABLE STORICO_CODA_S0_$(QvYearMonthQVD);
